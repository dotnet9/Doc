---
import ProjectLogo from '../components/ProjectLogo.astro';
import { byType, starText, loadMetrics, categories, platformLabels, hasAsset, type Project } from '../lib/projects';

interface Props {
  type: 'app' | 'lib';
  addCard?: boolean;
}
const { type, addCard = false } = Astro.props;
const list = byType(type);
const metrics = loadMetrics();
const shotSrc = (p: Project) => (p.heroShot && hasAsset(`${p.slug}/${p.heroShot}`) ? `/assets/${p.slug}/${p.heroShot.split('/').map(encodeURIComponent).join('/')}` : null);
---

{
  type === 'app' ? (
    <div class="app-grid">
      {list.map((p: Project) => {
        const shot = shotSrc(p);
        return (
          <a class="card hoverable app-card" href={`/${p.type}s/${p.slug}/`}>
            <span class="app-shot">
              {shot ? <img src={shot} alt={`${p.name} 界面预览`} loading="lazy" /> : (
                <span class="app-shot-fallback">
                  <ProjectLogo slug={p.slug} name={p.name} />
                </span>
              )}
            </span>
            <span class="app-card-body">
              <span class="card-top">
                <ProjectLogo slug={p.slug} name={p.name} size="sm" />
                <span>
                  <span class="nm">
                    {p.name}
                    {metrics.releases[p.slug]?.version && <span class="pill muted">v{metrics.releases[p.slug]!.version}</span>}
                  </span>
                  <span class="ds">{p.tagline}</span>
                </span>
              </span>
              <span class="card-foot">
                {p.platforms.map((pl) => (
                  <span class="pill blue">{platformLabels[pl]?.label ?? pl}</span>
                ))}
                <span class="spacer" />
                <span class="btn btn-ghost btn-sm">详情</span>
              </span>
            </span>
          </a>
        );
      })}
    </div>
  ) : (
    <>
      <div class="chip-row" data-chips>
        <button class="chip on" data-cat="all">
          全部
        </button>
        {Object.entries(categories).map(([key, c]) => (
          <button class="chip" data-cat={key}>
            {c.label}
          </button>
        ))}
      </div>
      <div class="lib-grid" data-libgrid>
        {list.map((p: Project) => {
          const pkg = p.primaryPackage || p.nuget?.[0];
          return (
            <div class="card hoverable lib-card" data-cat={p.category}>
              <div class="card-top">
                <ProjectLogo slug={p.slug} name={p.name} size="lg" />
                <div>
                  <div class="nm mono">{p.name}</div>
                  <div class="ds">{p.tagline}</div>
                </div>
              </div>
              {pkg && (
                <div class="pkg-line">
                  <span>dotnet add package {pkg}</span>
                  <button class="cp" data-copy={pkg} title="复制安装命令" type="button">
                    ⧉
                  </button>
                </div>
              )}
              <div class="foot">
                {metrics.releases[p.slug]?.version && <span class="pill">v{metrics.releases[p.slug]!.version}</span>}
                {p.frameworks.map((f) => (
                  <span class="fw">{f}</span>
                ))}
                <a class="gh-mini" href={`/${p.type}s/${p.slug}/`} style="margin-left:auto">
                  详情 →
                </a>
              </div>
            </div>
          );
        })}
        {addCard && (
          <div class="card lib-card add">
            <b>＋ 更多组件</b>
            <span>持续加入中，敬请期待</span>
          </div>
        )}
      </div>
    </>
  )
}

<script>
  // 分类筛选（组件库）
  document.querySelectorAll('[data-chips]').forEach((row) => {
    const grid = row.parentElement?.querySelector('[data-libgrid]');
    if (!grid) return;
    row.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        row.querySelectorAll('.chip').forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        const cat = chip.dataset.cat;
        grid.querySelectorAll<HTMLElement>('.lib-card').forEach((card) => {
          card.style.display = cat === 'all' || card.dataset.cat === cat ? '' : 'none';
        });
      });
    });
  });
  // 复制安装命令
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard?.writeText(`dotnet add package ${btn.dataset.copy}`);
      const old = btn.textContent;
      btn.textContent = '✓';
      setTimeout(() => (btn.textContent = old), 1200);
    });
  });
</script>

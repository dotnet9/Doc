---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import MindMap from '../components/MindMap.astro';
import Giscus from '../components/Giscus.astro';
import { projects, byType, recentUpdates, baseOf, hasAsset } from '../lib/projects';

const apps = byType('app');
const libs = byType('lib');
const updates = recentUpdates(8);
const pkgCount = projects.reduce((n, p) => n + (p.nuget?.length ?? 0), 0);
const visuals = apps.map((p) => ({
  p,
  shot: p.heroShot && hasAsset(`${p.slug}/${p.heroShot}`) ? `/assets/${p.slug}/${p.heroShot.split('/').map(encodeURIComponent).join('/')}` : null,
}));
---

<Base title="码坊 CodeWF · 开源应用与组件库" active="home">
  <div class="wrap">
    <MindMap />
  

    <section class="section" id="apps">
      <div class="sec-head">
        <h2>应用</h2><span class="en">Applications</span>
        <p>开箱即用 · 内置自动更新</p>
        <a class="more" href="/apps/">全部应用 →</a>
      </div>
      <ProjectGrid type="app" />
    </section>

    <section class="section" id="libs">
      <div class="sec-head">
        <h2>组件库</h2><span class="en">Libraries</span>
        <p>dotnet add 即用 · AOT 友好</p>
        <a class="more" href="/libs/">全部组件 →</a>
      </div>
      <ProjectGrid type="lib" addCard />
    </section>

    <section class="section" id="updates">
      <div class="sec-head">
        <h2>最近更新</h2><span class="en">Changelog Feed</span>
        <p>由各仓库更新日志自动聚合</p>
        <a class="more" href="/rss.xml">RSS 订阅 →</a>
      </div>
      <div class="upd-wrap">
        <ul class="timeline">
          {
            updates.map(({ project, entry }) => (
              <li class="tl-item">
                <ProjectLogo slug={project.slug} name={project.name} size="sm" />
                <div class="tl-body">
                  <div class="tl-title">
                    <a href={baseOf(project)}>{project.name}</a>
                    {entry.version && <span class="ver">{entry.version}</span>}
                    <time>{entry.date ?? ''}</time>
                  </div>
                  <div class="tl-digest">{entry.digest || entry.title}</div>
                </div>
                <a class="tl-link" href={`${baseOf(project)}changelog/`}>
                  更新日志 →
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section">
      <Giscus />
    </section>
  </div>
</Base>

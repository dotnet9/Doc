---
/**
 * 界面演示轮播：主图 + 缩略图，自动播放（悬停/聚焦暂停），支持键盘与点击切换。
 * 动图与静态图混排——有 GIF 的场景会自己动起来。
 */
interface Shot {
  src: string;
  caption: string;
  tag: string;
  animated?: boolean;
}
interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;
---

{
  shots.length > 0 && (
    <div class="carousel" id="vexCarousel" data-count={shots.length}>
      <div class="carousel-stage">
        {shots.map((s, i) => (
          <figure class:list={['carousel-slide', { on: i === 0 }]} data-slide={i}>
            <img
              src={s.src}
              alt={s.caption}
              width="1200"
              height="759"
              loading={i === 0 ? 'eager' : 'lazy'}
              data-animated={s.animated ? 'true' : 'false'}
            />
            <figcaption>
              <span class="cs-tag">{s.tag}</span>
              {s.caption}
            </figcaption>
          </figure>
        ))}
        <button class="carousel-nav prev" type="button" data-dir="-1" aria-label="上一张">‹</button>
        <button class="carousel-nav next" type="button" data-dir="1" aria-label="下一张">›</button>
        <div class="carousel-dots" role="tablist" aria-label="界面演示切换">
          {shots.map((s, i) => (
            <button
              type="button"
              class:list={['carousel-dot', { on: i === 0 }]}
              data-go={i}
              role="tab"
              aria-label={s.tag}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
      </div>
      <div class="carousel-thumbs">
        {shots.map((s, i) => (
          <button type="button" class:list={['carousel-thumb', { on: i === 0 }]} data-go={i} title={s.caption}>
            <img src={s.src} alt="" loading="lazy" />
            <span>{s.tag}</span>
          </button>
        ))}
      </div>
      <div class="carousel-bar" aria-hidden="true"><i /></div>
    </div>
  )
}

<script>
  (function () {
    const root = document.getElementById('vexCarousel');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel-thumb'));
    const bar = root.querySelector<HTMLElement>('.carousel-bar i');
    const PERIOD = 5200;
    let index = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle('on', n === index));
      dots.forEach((d, n) => {
        d.classList.toggle('on', n === index);
        d.setAttribute('aria-selected', n === index ? 'true' : 'false');
      });
      thumbs.forEach((t, n) => t.classList.toggle('on', n === index));
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
    };

    const start = () => {
      stop();
      timer = window.setInterval(() => show(index + 1), PERIOD);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.go));
        start();
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(index + Number(btn.dataset.dir));
        start();
      });
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowLeft') show(index - 1);
      else if (k === 'ArrowRight') show(index + 1);
    });

    // 触摸滑动
    let x0 = 0;
    root.addEventListener(
      'touchstart',
      (e) => {
        x0 = (e as TouchEvent).touches[0].clientX;
        stop();
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (e) => {
        const dx = (e as TouchEvent).changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
        start();
      },
      { passive: true },
    );

    // 视口外暂停，避免后台空转
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => (entries[0].isIntersecting ? start() : stop()),
        { threshold: 0.15 },
      ).observe(root);
    } else {
      start();
    }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) stop();
  })();
</script>
